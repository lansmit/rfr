{
  "permissions": {
    "allow": [
      "mcp__idea__search_symbol",
      "mcp__idea__get_symbol_info",
      "mcp__idea__analyze_calls",
      "mcp__idea__get_file_problems",
      "mcp__idea__lint_files",
      "mcp__idea__get_all_open_file_paths",
      "mcp__idea__open_file_in_editor",
      "mcp__idea__list_directory_tree",
      "mcp__idea__list_database_connections",
      "mcp__idea__list_database_schemas",
      "mcp__idea__list_schema_object_kinds",
      "mcp__idea__list_schema_objects",
      "mcp__idea__introspect_schema",
      "mcp__idea__get_database_object_description",
      "mcp__idea__preview_table_data",

      "Bash(./gradlew runAll)",
      "Bash(./gradlew stopAll)",
      "Bash(./gradlew :rfr-auth:bootRun)",
      "Bash(./gradlew :rfr-api:bootRun)",
      "Bash(bash ports.sh)",

      "Bash(npm run dev)",

      "Bash(bash localenv.sh)",
      "Bash(docker compose up -d mysql --wait)",
      "Bash(docker compose stop)",
      "Bash(docker compose down)",

      "Bash(./gradlew e2e)",
      "Bash(./gradlew e2e *)",
      "Bash(./gradlew :rfr-e2e:test)",
      "Bash(./gradlew :rfr-e2e:test *)",

      "Bash(mv * *.bak)",
      "Bash(cp * *.bak)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(rm *)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "env": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "remote.origin.pushurl",
    "GIT_CONFIG_VALUE_0": "no-push-from-agent"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push-and-delete.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-changed-file.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
